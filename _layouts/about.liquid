---
layout: default
---
{% assign strings = site.data[site.active_lang].strings.home %}
<div class="home">
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{{ page.hero.kicker }}</p>
      <h1 class="hero-title">
        {{ site.first_name }}<br><em>{{ site.last_name }}</em>
      </h1>
      <div class="hero-lede">{{ content }}</div>
      <ul class="hero-links">
        <li><a href="mailto:{{ site.email }}">{{ strings.email }}</a></li>
        <li><a href="https://github.com/{{ site.github_username }}">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/{{ site.linkedin_username }}">LinkedIn</a></li>
        <li><a href="{{ '/cv/' | relative_url }}">{{ strings.cv }}</a></li>
      </ul>
    </div>
    {% if page.profile.image %}
      <figure class="hero-portrait">
        <img
          class="only-light"
          src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          width="480"
          height="600"
        >
        <img
          class="only-dark"
          src="{{ page.profile.image_dark | default: page.profile.image | prepend: '/assets/img/' | relative_url }}"
          alt="{{ site.first_name }} {{ site.last_name }}"
          width="480"
          height="600"
        >
      </figure>
    {% endif %}
  </section>

  {% assign featured = site.projects | where_exp: 'p', 'p.featured' | sort: 'featured' %}
  {% if featured.size > 0 %}
    <section class="index-section">
      <header class="section-head">
        <h2>{{ strings.selected_work }}</h2>
        <a class="section-link" href="{{ '/projects/' | relative_url }}">{{ strings.all_projects }} →</a>
      </header>
      <ol class="project-index">
        {% for project in featured %}
          {% include project_row.liquid project=project number=forloop.index %}
        {% endfor %}
      </ol>
    </section>
  {% endif %}

  <section class="contact-block">
    <p class="eyebrow">{{ strings.contact_kicker }}</p>
    <p class="contact-line">{{ strings.contact_line }}</p>
    <a class="contact-mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
  </section>
</div>
